# Local-only development values. Do not use these credentials outside a local environment.
COMPOSE_PROJECT_NAME=commerce-logistics-platform

RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
RABBITMQ_DEFAULT_USER=dev_rabbitmq
RABBITMQ_DEFAULT_PASS=dev_rabbitmq_password
RABBITMQ_AMQP_PORT=5673
RABBITMQ_MANAGEMENT_PORT=15673

POSTGRES_IMAGE=postgres:16-alpine

# Application image build inputs. These are development defaults, not release tags.
COMMERCE_PHP_IMAGE=php:8.4-cli-bookworm
COMMERCE_COMPOSER_IMAGE=composer:2
LOGISTICS_GO_BUILD_IMAGE=golang:1.26-alpine
LOGISTICS_GO_RUNTIME_IMAGE=alpine:3.22
NOTIFICATIONS_NODE_IMAGE=node:24-bookworm-slim

# Application host ports and local-only Laravel runtime key.
COMMERCE_API_PORT=8000
LOGISTICS_API_PORT=8080
NOTIFICATIONS_API_PORT=3000
COMMERCE_APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

COMMERCE_DB_NAME=commerce_dev
COMMERCE_DB_USER=commerce_dev
COMMERCE_DB_PASSWORD=commerce_dev_password
COMMERCE_DB_PORT=55432

LOGISTICS_DB_NAME=logistics_dev
LOGISTICS_DB_USER=logistics_dev
LOGISTICS_DB_PASSWORD=logistics_dev_password
LOGISTICS_DB_PORT=55433

NOTIFICATIONS_DB_NAME=notifications_dev
NOTIFICATIONS_DB_USER=notifications_dev
NOTIFICATIONS_DB_PASSWORD=notifications_dev_password
NOTIFICATIONS_DB_PORT=55434
