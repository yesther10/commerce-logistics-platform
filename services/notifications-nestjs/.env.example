# Local development values for the notifications-owned PostgreSQL database.
DB_HOST=127.0.0.1
DB_PORT=55434
DB_DATABASE=notifications_dev
DB_USERNAME=notifications_dev
DB_PASSWORD=notifications_dev_password
HTTP_PORT=3000
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://dev_rabbitmq:dev_rabbitmq_password@127.0.0.1:5673/
RABBITMQ_SHIPMENT_CREATED_QUEUE=notifications.logistics.shipment.created
RABBITMQ_SHIPMENT_CREATED_DLQ=notifications.logistics.shipment.created.dlq
RABBITMQ_NOTIFICATION_REQUESTED_QUEUE=notifications.requested
RABBITMQ_NOTIFICATION_REQUESTED_DLQ=notifications.requested.dlq
RABBITMQ_NOTIFICATIONS_RETRY_QUEUE_1=notifications.retry.1
RABBITMQ_NOTIFICATIONS_RETRY_QUEUE_2=notifications.retry.2
RABBITMQ_NOTIFICATIONS_RETRY_QUEUE_3=notifications.retry.3
RABBITMQ_NOTIFICATIONS_RETRY_DELAY_1_MS=1000
RABBITMQ_NOTIFICATIONS_RETRY_DELAY_2_MS=5000
RABBITMQ_NOTIFICATIONS_RETRY_DELAY_3_MS=15000
OUTBOX_POLL_INTERVAL=1000
OUTBOX_BATCH_SIZE=100
